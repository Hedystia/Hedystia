{
  "name": "@hedystia/view",
  "version": "2.3.22",
  "description": "Reactive UI engine — fine-grained signals, no Virtual DOM, real DOM nodes",
  "homepage": "https://docs.hedystia.com",
  "private": false,
  "keywords": [
    "hedystia",
    "view",
    "ui",
    "reactive",
    "signals",
    "typescript",
    "type-safe",
    "jsx"
  ],
  "license": "MIT",
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.cts",
      "import": "./dist/jsx-runtime.mjs",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.cts",
      "import": "./dist/jsx-dev-runtime.mjs",
      "require": "./dist/jsx-dev-runtime.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.cts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./signal": {
      "types": "./dist/signal/index.d.cts",
      "import": "./dist/signal/index.mjs",
      "require": "./dist/signal/index.cjs"
    },
    "./jsx": {
      "types": "./dist/jsx/index.d.cts",
      "import": "./dist/jsx/index.mjs",
      "require": "./dist/jsx/index.cjs"
    },
    "./render": {
      "types": "./dist/render/engine.d.cts",
      "import": "./dist/render/engine.mjs",
      "require": "./dist/render/engine.cjs"
    },
    "./flow": {
      "types": "./dist/render/flow.d.cts",
      "import": "./dist/render/flow.mjs",
      "require": "./dist/render/flow.cjs"
    },
    "./store": {
      "types": "./dist/store/index.d.cts",
      "import": "./dist/store/index.mjs",
      "require": "./dist/store/index.cjs"
    },
    "./watch": {
      "types": "./dist/watch/index.d.cts",
      "import": "./dist/watch/index.mjs",
      "require": "./dist/watch/index.cjs"
    },
    "./context": {
      "types": "./dist/context/index.d.cts",
      "import": "./dist/context/index.mjs",
      "require": "./dist/context/index.cjs"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.cts",
      "import": "./dist/lifecycle/index.mjs",
      "require": "./dist/lifecycle/index.cjs"
    },
    "./fetch": {
      "types": "./dist/fetch/index.d.cts",
      "import": "./dist/fetch/index.mjs",
      "require": "./dist/fetch/index.cjs"
    },
    "./style": {
      "types": "./dist/style/index.d.cts",
      "import": "./dist/style/index.mjs",
      "require": "./dist/style/index.cjs"
    },
    "./text": {
      "types": "./dist/text/index.d.cts",
      "import": "./dist/text/index.mjs",
      "require": "./dist/text/index.cjs"
    },
    "./scheduler": {
      "types": "./dist/scheduler/index.d.cts",
      "import": "./dist/scheduler/index.mjs",
      "require": "./dist/scheduler/index.cjs"
    },
    "./svg-map": {
      "types": "./dist/svg-map.d.cts",
      "import": "./dist/svg-map.mjs",
      "require": "./dist/svg-map.cjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "vite": ">= 7.3.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Zastinian",
    "email": "contact@zastinian.com",
    "url": "https://github.com/Zastinian"
  }
}
