{
  "name": "@hedystia/view",
  "version": "2.4.7",
  "description": "Fine-grained reactive JSX UI with signals, SSR, lifecycle cleanup and race-safe async resources.",
  "homepage": "https://docs.hedystia.com",
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "ui",
    "signals",
    "reactive",
    "jsx",
    "ssr",
    "async"
  ],
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.cts",
      "import": "./dist/jsx-runtime.mjs",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.cts",
      "import": "./dist/jsx-dev-runtime.mjs",
      "require": "./dist/jsx-dev-runtime.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.cts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.cts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.cjs"
    },
    "./static/jsx-runtime": {
      "types": "./dist/static/jsx-runtime.d.cts",
      "import": "./dist/static/jsx-runtime.mjs",
      "require": "./dist/static/jsx-runtime.cjs"
    },
    "./static/jsx-dev-runtime": {
      "types": "./dist/static/jsx-dev-runtime.d.cts",
      "import": "./dist/static/jsx-dev-runtime.mjs",
      "require": "./dist/static/jsx-dev-runtime.cjs"
    },
    "./build": {
      "types": "./dist/build/index.d.cts",
      "import": "./dist/build/index.mjs",
      "require": "./dist/build/index.cjs"
    },
    "./islands": {
      "types": "./dist/islands/index.d.cts",
      "import": "./dist/islands/index.mjs",
      "require": "./dist/islands/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "vite": ">= 8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  }
}
