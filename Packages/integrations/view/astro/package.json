{
  "name": "@hedystia/astro",
  "version": "2.5.0",
  "description": "Use reactive Hedystia View components in Astro with SSR, client islands and navigation cleanup.",
  "homepage": "https://docs.hedystia.com",
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "astro",
    "astro-integration",
    "signals",
    "jsx",
    "ssr",
    "islands"
  ],
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client.js": {
      "types": "./dist/client.d.cts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./server.js": {
      "types": "./dist/server.d.cts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "@hedystia/view": "workspace:*"
  },
  "peerDependencies": {
    "@hedystia/view": ">= 2.4.7",
    "astro": ">= 6.0.0",
    "vite": ">= 7.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  }
}
