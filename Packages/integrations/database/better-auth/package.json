{
  "name": "@hedystia/better-auth",
  "version": "2.4.7",
  "description": "Better Auth adapter for Hedystia DB with schema generation, transactions and validated pagination.",
  "homepage": "https://docs.hedystia.com",
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "better-auth",
    "authentication",
    "database",
    "orm",
    "adapter"
  ],
  "license": "MIT",
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
