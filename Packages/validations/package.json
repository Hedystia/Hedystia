{
  "name": "@hedystia/validations",
  "version": "2.4.7",
  "description": "Composable TypeScript validation with Standard Schema interoperability, async checks and inferred object helpers.",
  "homepage": "https://docs.hedystia.com/validations/start",
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "validation",
    "schema",
    "standard-schema",
    "json-schema",
    "type-inference"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  },
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  }
}
