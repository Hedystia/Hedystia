{
  "name": "@hedystia/client",
  "version": "2.5.0",
  "description": "End-to-end typed HTTP client with injectable fetch, request cancellation, SSE and WebSockets.",
  "homepage": "https://docs.hedystia.com",
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@hedystia/ws": "workspace:*",
    "hedystia": "workspace:*"
  },
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "http-client",
    "type-safe",
    "fetch",
    "abortcontroller",
    "sse",
    "websocket"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  },
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  }
}
