{
  "name": "hedystia",
  "version": "2.5.0",
  "description": "Schema-first TypeScript HTTP server with typed routes, SSE, WebSockets and embedded route tests.",
  "homepage": "https://docs.hedystia.com",
  "dependencies": {
    "@hedystia/types": "workspace:*",
    "@hedystia/validations": "workspace:*",
    "@hedystia/ws": "workspace:*",
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "http-server",
    "type-safe",
    "validation",
    "sse",
    "websocket",
    "bun",
    "nodejs"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  },
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  }
}
