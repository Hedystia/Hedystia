{
  "name": "@hedystia/types",
  "version": "2.4.7",
  "description": "Generate portable TypeScript route declarations in memory or on disk for typed API consumers.",
  "homepage": "https://docs.hedystia.com/plugins/types",
  "dependencies": {
    "@hedystia/validations": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "code-generation",
    "api-client",
    "type-safe",
    "schema"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  },
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  }
}
