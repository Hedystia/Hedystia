{
  "name": "@hedystia/ws",
  "version": "2.4.7",
  "description": "Native-runtime WebSocket server and client with topic pub/sub, binary controls and queue visibility.",
  "homepage": "https://docs.hedystia.com/plugins/websocket",
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "websocket",
    "pubsub",
    "realtime",
    "bun",
    "nodejs",
    "deno"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  },
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.cts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.cts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    }
  }
}
