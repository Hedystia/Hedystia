{
  "name": "@hedystia/swagger",
  "version": "2.4.7",
  "description": "Generate OpenAPI documentation and interactive API docs from Hedystia route schemas and custom headers.",
  "homepage": "https://docs.hedystia.com/plugins/swagger",
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "hedystia": "workspace:*",
    "openapi-types": "^12.1.3"
  },
  "peerDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "openapi-types": ">= 12.0.0"
  },
  "peerDependenciesMeta": {
    "@apidevtools/swagger-parser": {
      "optional": false
    },
    "openapi-types": {
      "optional": true
    }
  },
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "openapi",
    "swagger",
    "api-documentation",
    "json-schema"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  },
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  }
}
