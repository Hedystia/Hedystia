{
  "name": "@hedystia/adapter",
  "version": "2.5.0",
  "description": "Deploy Hedystia across runtimes with native Node request streams, streaming responses and cookie fidelity.",
  "homepage": "https://docs.hedystia.com/plugins/adapter",
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "hedystia": "workspace:*"
  },
  "private": false,
  "keywords": [
    "hedystia",
    "typescript",
    "adapter",
    "nodejs",
    "cloudflare-workers",
    "aws-lambda",
    "vercel",
    "streaming"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  },
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  }
}
