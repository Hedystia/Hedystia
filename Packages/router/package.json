{
  "name": "@hedystia/router",
  "version": "2.4.7",
  "description": "Typed View routing with nested layouts, generated lazy routes, shared loaders and native navigation.",
  "homepage": "https://docs.hedystia.com/client/router",
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hedystia/Hedystia"
  },
  "author": {
    "name": "Hedystia",
    "email": "contact@hedystia.com",
    "url": "https://github.com/Hedystia"
  },
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.cts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    }
  },
  "keywords": [
    "hedystia",
    "router",
    "typescript",
    "type-safe",
    "routing",
    "view-transitions"
  ],
  "files": [
    "dist",
    "readme.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@hedystia/query": "workspace:*",
    "@hedystia/view": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">= 8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
